{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  // Type-aware rules need oxlint-tsgolint and TypeScript 7, both installed.
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  // react-perf is deliberately absent. It asks for useCallback/useMemo around
  // inline props, which is exactly what the React Compiler (enabled in both
  // Vite apps) already inserts. Every warning it produced here came from an
  // API that cannot avoid the shape anyway: Base UI's `render={<Button />}`
  // and TanStack Form's render props. Hand-memoizing them would be writing the
  // workaround the compiler exists to delete.
  "plugins": ["typescript", "unicorn", "import", "react", "jsx-a11y"],
  "env": { "browser": true, "es2024": true, "node": true },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "warn",
    // The automatic JSX runtime means React is never in scope by hand.
    "react/react-in-jsx-scope": "off",
    // Stylesheet imports have no binding and are the normal way to load CSS.
    "import/no-unassigned-import": "off",
    // Turns on multi-file analysis: oxlint builds the module graph and reports
    // circular imports across packages, which the app/package layering forbids.
    "import/no-cycle": "error",
    // Not in an enabled category, so the gate stayed silent while an editor
    // flagged it. An index key survives a reorder and hands the new row the old
    // row's state.
    "react/no-array-index-key": "error"
  },
  "ignorePatterns": [
    "apps/cms/**",
    "**/dist/**",
    "**/.next/**",
    "**/drizzle/**",
    "**/routeTree.gen.ts",
    "**/next-env.d.ts"
  ],
  "overrides": [
    {
      "files": ["apps/api/**", "packages/db/**"],
      "rules": { "no-console": "off" }
    }
  ]
}
