{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  // Type-aware rules need oxlint-tsgolint and TypeScript 7, both installed.
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  // react-perf is deliberately absent. It asks for useCallback/useMemo around
  // inline props, which is exactly what the React Compiler (enabled in both
  // Vite apps) already inserts. Every warning it produced here came from an
  // API that cannot avoid the shape anyway: Base UI's `render={<Button />}`
  // and TanStack Form's render props. Hand-memoizing them would be writing the
  // workaround the compiler exists to delete.
  "plugins": ["typescript", "unicorn", "import", "react", "jsx-a11y"],
  "env": { "browser": true, "es2024": true, "node": true },
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "warn",
    // The automatic JSX runtime means React is never in scope by hand.
    "react/react-in-jsx-scope": "off",
    // Stylesheet imports have no binding and are the normal way to load CSS.
    "import/no-unassigned-import": "off",
    // Turns on multi-file analysis: oxlint builds the module graph and reports
    // circular imports across packages, which the app/package layering forbids.
    "import/no-cycle": "error",
    // Not in an enabled category, so the gate stayed silent while an editor
    // flagged it. An index key survives a reorder and hands the new row the old
    // row's state.
    "react/no-array-index-key": "error"
  },
  "ignorePatterns": [
    "apps/cms/**",
    "**/dist/**",
    "**/.next/**",
    "**/drizzle/**",
    "**/routeTree.gen.ts",
    "**/next-env.d.ts",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.github/**",
    "**/.impeccable/**"
  ],
  "overrides": [
    {
      "files": ["apps/api/**", "packages/db/**"],
      "rules": { "no-console": "off" }
    },
    // Two shadcn components whose generated shape this config would otherwise
    // reject. Scoped to the files rather than to the component directory, so a
    // component we write by hand still gets the full rule set.
    //
    // calendar.tsx passes its subcomponents inline through react-day-picker's
    // `components` prop, which is that library's API, and they reuse the outer
    // `className` and `props` names. input-group.tsx marks its addon
    // `role="group"` and lets a click on it focus the input beside it; the
    // input itself is reachable by keyboard, so the handler is a shortcut, not
    // the only way in. Both files are regenerated by `shadcn add`, so fixing
    // them in place would be undone by the next update.
    {
      "files": [
        "packages/ui/src/components/calendar.tsx",
        "packages/ui/src/components/input-group.tsx"
      ],
      "rules": {
        "eslint/no-shadow": "off",
        "react/no-unstable-nested-components": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
