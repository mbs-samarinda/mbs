{
  "name": "@mbs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint -c ../../.oxlintrc.json",
    "format": "oxfmt -c ../../.oxfmtrc.json .",
    "format:check": "oxfmt --check -c ../../.oxfmtrc.json ."
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@mbs/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2",
    "vitest": "^4.0.0"
  }
}
