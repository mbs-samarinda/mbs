{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "types": ["node"],
    // Node runs these files by stripping types, which cannot handle enums,
    // namespaces or parameter properties. Catch them here instead of at boot.
    "erasableSyntaxOnly": true
  }
}
