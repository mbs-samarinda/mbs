node_modules/
dist/
build/
.next/
# Next rewrites it on every dev start and build, with different paths for
# each, and its docs say not to track it. tsc passes without it.
next-env.d.ts
.turbo/
coverage/
*.tsbuildinfo

.env
.env.*
!.env.example

.DS_Store

# Per-machine Claude Code permissions. The tracked settings.json is shared;
# this one is not.
.claude/settings.local.json

# Throwaway checkouts an agent works in. Each one carries its own node_modules,
# so committing them would add gigabytes of a copy of this repository to this
# repository.
.claude/worktrees/

# Editor config. Zed's Docker Compose server parses every YAML as one
# document and chokes on the two-document pnpm-lock.yaml; the fix is a
# personal preference, not a repo rule.
.zed/

# Local RTK command statistics
.rtk/

# Strapi generated output
apps/cms/.strapi/
apps/cms/.tmp/
apps/cms/types/generated/
apps/cms/public/uploads/*
!apps/cms/public/uploads/.gitkeep

# What Playwright leaves behind when an e2e test fails
apps/profile/test-results/

# Turborepo
.turbo
apps/cms/.strapi-updater.json
