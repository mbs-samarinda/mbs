node_modules/
dist/
build/
.next/
.turbo/
coverage/
*.tsbuildinfo

.env
.env.*
!.env.example

.DS_Store

# Per-machine Claude Code permissions. The tracked settings.json is shared;
# this one is not.
.claude/settings.local.json
.codex/config.toml

# Editor config. Zed's Docker Compose server parses every YAML as one
# document and chokes on the two-document pnpm-lock.yaml; the fix is a
# personal preference, not a repo rule.
.zed/

# Local RTK command statistics
.rtk/

# Strapi generated output
apps/cms/.strapi/
apps/cms/.tmp/
apps/cms/types/generated/
apps/cms/public/uploads/*
!apps/cms/public/uploads/.gitkeep

# Turborepo
.turbo

# Impeccable ships a compiled engine per host directory. Its launcher finds the
# right binary for the current platform — user cache, PATH, or a checksummed
# download — so committing a 12MB Apple Silicon build three times would add
# 37MB of history that Linux CI and Intel Macs cannot run anyway.
.agents/skills/*/scripts/bin/
.claude/skills/*/scripts/bin/
.github/skills/*/scripts/bin/
