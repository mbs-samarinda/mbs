# No real values here. Copy to .env and fill in.
# Blank means "use the default", so only the values below have to be set.

DATABASE_URL=

# development | test | production. Default: development
NODE_ENV=
# fatal | error | warn | info | debug | trace. Default: info
LOG_LEVEL=
# Default: 3001, which is what both front-end dev proxies expect.
PORT=

# At least 32 characters. Generate one per environment; never reuse it for
# anything else.
BETTER_AUTH_SECRET=
# Each app's own origin, NOT a separate API host. In production these are
# https://admission.mbss.sch.id and https://admin.mbss.sch.id.
FAMILY_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
# From the Google Cloud console. One client, two authorised redirect URIs:
# <FAMILY_APP_URL>/api/auth/callback/google and
# <ADMIN_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where email goes out. smtp://user:pass@host:port, or smtps:// for TLS from
# the first byte.
SMTP_URL=smtp://localhost:1025
# A bare address or "Name <address>".
MAIL_FROM=PPDB MBSS <ppdb@mbss.sch.id>
# on | off. Default: on. Sends queued email from inside the API process.
NOTIFICATION_WORKER=
# Optional. Ensured as an active administrator with access to every school on
# every boot. Set it once to get the first administrator in; nothing can grant
# staff access before one exists.
BOOTSTRAP_ADMIN_EMAIL=

# Not read yet. They arrive with the features that need them.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# PII_ENCRYPTION_KEY=
# PII_FINGERPRINT_KEY=
