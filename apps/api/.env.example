# No real values here. Copy to .env and fill in.
# Blank means "use the default", so only the values below have to be set.

DATABASE_URL=

# development | test | production. Default: development
NODE_ENV=
# fatal | error | warn | info | debug | trace. Default: info
LOG_LEVEL=
# Default: 3001, which is what both front-end dev proxies expect.
PORT=

# At least 32 characters. Generate one per environment; never reuse it for
# anything else.
BETTER_AUTH_SECRET=
# The origin the committee app is served from, NOT a separate API host. The
# session cookie is host-only, so it has to be set on the host the app calls
# from. In production that is https://admin.mbss.sch.id, with Caddy sending
# /api to this server. Locally the two ports share a cookie jar, so either
# works.
BETTER_AUTH_URL=http://localhost:3001
# From the Google Cloud console. Authorised redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The committee app's origin.
ADMIN_APP_URL=http://localhost:5174
# Optional. Ensured as an active administrator with access to every school on
# every boot. Set it once to get the first administrator in; nothing can grant
# staff access before one exists.
BOOTSTRAP_ADMIN_EMAIL=

# Not read yet. They arrive with the features that need them.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# PII_ENCRYPTION_KEY=
# PII_FINGERPRINT_KEY=
