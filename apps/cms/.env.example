# No real values here. Copy to .env and fill in locally.
HOST=
PORT=

# Strapi's own database, separate from the core one. Strapi owns this schema
# and the core migrations never touch it.
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
