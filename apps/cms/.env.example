# No real values here. Copy to .env and fill in locally.
HOST=
PORT=
# Public address used in password reset emails.
PUBLIC_URL=http://localhost:1337

# Strapi's own database, separate from the core one. Strapi owns this schema
# and the core migrations never touch it.
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Where to tell the profile application that content changed, and the secret it
# checks. Both must match apps/profile/.env. Unset means no profile is notified
# and its pages wait out their own cache window instead.
PROFILE_REVALIDATE_URL=http://localhost:3002/api/revalidate
REVALIDATE_SECRET=

# Media storage. Leave AWS_BUCKET empty and Strapi keeps its filesystem
# provider, writing to public/uploads — which is what local development wants.
# Production sets all of these, from /opt/mbs/.env on the box.
#
# Biznet Gio speaks S3 with SigV4 and addresses buckets by path.
# AWS_BASE_URL is what Strapi puts in the URL it hands the browser, so it has to
# be publicly reachable: endpoint + bucket, or a CDN in front of it.
AWS_BUCKET=
AWS_ENDPOINT=https://nos.jkt-1.neo.id
AWS_REGION=idn
AWS_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
