{
  "kind": "collectionType",
  "collectionName": "pengumuman",
  "info": {
    "singularName": "pengumuman",
    "pluralName": "pengumuman-list",
    "displayName": "Pengumuman",
    "description": "Seperti Berita, dengan masa berlaku opsional. Setelah lewat, hilang dari listing."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "ownerKey": {
      "type": "enumeration",
      "enum": ["mbs", "smp", "smk", "sma"],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text",
      "maxLength": 300
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "attribution": {
      "type": "string"
    },
    "expiresAt": {
      "type": "datetime"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
