{
  "kind": "collectionType",
  "collectionName": "opini",
  "info": {
    "singularName": "opini",
    "pluralName": "opini-list",
    "displayName": "Opini",
    "description": "Tulisan satu orang atas namanya sendiri. Tampil di Artikel bersama Berita dan Pengumuman."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "ownerKey": {
      "type": "enumeration",
      "enum": ["mbs", "smp", "smk", "sma"],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string"
    },
    "authorName": {
      "type": "string",
      "required": true
    },
    "authorRole": {
      "type": "string",
      "required": true,
      "description": "Peran penulis, misalnya Guru Fisika atau Siswa Kelas XI."
    },
    "summary": {
      "type": "text",
      "maxLength": 300
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
