{
  "kind": "collectionType",
  "collectionName": "fasilitas",
  "info": {
    "singularName": "fasilitas",
    "pluralName": "fasilitas-list",
    "displayName": "Fasilitas",
    "description": "Fasilitas sekolah dengan keterangan dan gambar, masing-masing punya halaman detail."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "ownerKey": {
      "type": "enumeration",
      "enum": ["mbs", "smp", "smk", "sma"],
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "summary": {
      "type": "text",
      "maxLength": 300
    },
    "meta": {
      "type": "string",
      "maxLength": 60
    },
    "body": {
      "type": "richtext"
    },
    "facts": {
      "type": "component",
      "repeatable": true,
      "component": "shared.fact-row"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
