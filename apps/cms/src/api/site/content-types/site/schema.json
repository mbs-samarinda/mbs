{
  "kind": "collectionType",
  "collectionName": "sites",
  "info": {
    "singularName": "site",
    "pluralName": "site-list",
    "displayName": "Situs",
    "description": "Satu baris per pemilik: identitas, tagline, navigasi, footer, dan kontak."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "ownerKey": {
      "type": "enumeration",
      "enum": ["mbs", "smp", "smk", "sma"],
      "required": true,
      "unique": true
    },
    "tagline": {
      "type": "string",
      "required": true,
      "description": "Setiap pemilik punya tagline. Di mana tagline boleh tampil adalah aturan merek, bukan aturan CMS: janji payung hanya di permukaan payung, tagline sekolah hanya di situs sekolah itu, tidak pernah keduanya pada satu permukaan."
    },
    "brandSubline": { "type": "string" },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "address": { "type": "text" },
    "mapsCoordinates": {
      "type": "string",
      "regex": "^$|^-?\\d+(\\.\\d+)?,\\s*-?\\d+(\\.\\d+)?$",
      "description": "Titik peta sebagai \"lintang,bujur\", misalnya -0.4656565,117.1953527. Salin dari Google Maps: klik kanan lokasi, lalu klik angka koordinat. Kosongkan untuk menyembunyikan peta."
    },
    "hours": { "type": "string" },
    "legal": { "type": "string" },
    "copyright": { "type": "string" },
    "admissionCta": { "type": "string", "required": true },
    "navigation": { "type": "component", "repeatable": true, "component": "shared.link" },
    "headerPhone": { "type": "component", "repeatable": false, "component": "shared.link" },
    "headerWhatsapp": { "type": "component", "repeatable": false, "component": "shared.link" },
    "footerColumns": {
      "type": "component",
      "repeatable": true,
      "component": "shared.footer-column"
    },
    "contacts": {
      "type": "component",
      "repeatable": true,
      "component": "shared.contact-channel"
    },
    "socials": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link",
      "description": "Akun resmi. Hanya tampil di halaman Kontak; footer tidak menampilkannya."
    },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
