{
  "extends": "@mbs/typescript-config/react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "next-env.d.ts",
    "next.config.ts",
    "cache-handler.ts",
    "cache-handler.test.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
