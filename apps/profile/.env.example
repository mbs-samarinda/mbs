# PROFILE_APEX swaps the domain every owner is resolved and linked under.
#
# Export it in the deploy's BUILD environment — not in a .env file here. Two
# reasons, and both bite silently. Owner pages prerender, so the school
# switcher's absolute links are baked in at build: setting it only where the
# server runs leaves the switcher pointing at production. And turbo hashes the
# variable, not the file: an ignored .env.local is not a build input, so a
# staging build that reads it matches production's hash and replays the cached
# artifact.
#
#   PROFILE_APEX=staging.example.com pnpm build

# The two services the pages read. Both are validated in src/config/env.ts and
# both default to the local ports, so a fresh clone needs neither set.
#
# CMS_URL is Strapi: published profile content, read with no token. The CMS
# grants the Public role find/findOne on boot.
CMS_URL=http://localhost:1337
# API_BASE_URL is Fastify: the only source of admission dates, fees and state.
API_BASE_URL=http://localhost:3001

# Shared with apps/cms, which sends it on publish so the pages drop their cache
# instead of waiting out the hour. At least 16 characters. Leave it unset and
# the endpoint refuses every request — the pages still work, just later.
#
#   openssl rand -hex 24
REVALIDATE_SECRET=
