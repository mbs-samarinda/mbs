# PROFILE_APEX swaps the domain every owner is resolved and linked under.
#
# Set it where the server runs. The build runs in compile mode and prerenders
# nothing, so it is read once per process, when `owners.ts` and
# `theme-script.tsx` first load: changing it needs a restart, not a rebuild.
# Unset means production, `mbss.sch.id`.
#
#   PROFILE_APEX=staging.example.com pnpm start

# The two services the pages read. Both are validated in src/config/env.ts and
# both default to the local ports, so a fresh clone needs neither set.
#
# CMS_URL is Strapi: published profile content.
CMS_URL=http://localhost:1337
# The key every CMS read sends. apps/cms sets its read token to the same value
# on boot, so the two .env files must match. This one is for local use only;
# production gets its own from infra/generate-secrets.sh.
CMS_READ_TOKEN=local-dev-profile-read-token-not-a-secret
# API_BASE_URL is Fastify: the only source of admission dates, fees and state.
API_BASE_URL=http://localhost:3001

# Shared with apps/cms, which sends it on publish so the pages drop their cache
# instead of waiting out the hour. At least 16 characters. Leave it unset and
# the endpoint refuses every request — the pages still work, just later.
#
#   openssl rand -hex 24
REVALIDATE_SECRET=
