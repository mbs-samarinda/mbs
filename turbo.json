{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // CMS_URL and MEDIA_BASE_URL are both read at build time by the
      // profile's next.config.ts, which turns them into
      // images.remotePatterns. Without them in the hash, a build against a
      // different CMS or bucket replays the cached artifact and every uploaded
      // photograph 500s with "hostname is not configured".
      //
      // PROFILE_APEX no longer changes the build — nothing prerenders, so the
      // switcher's links come from the serving process. It is kept here anyway:
      // it costs nothing, and a future prerender would need it.
      "env": ["CMS_URL", "MEDIA_BASE_URL", "PROFILE_APEX"],
      // infra/image-tag.sh tags every image with this hash, so anything here
      // decides whether a merge redeploys. Tests never reach a build output:
      // without these negations a test-only change would restart production.
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!test/**", "!vitest.config.*"],
      "outputs": [
        "dist/**",
        "build/**",
        ".strapi/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      // base.json sets incremental, so tsc --noEmit still writes this.
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      // The profile suite pins this in its vitest config so an ambient value
      // cannot change the result; it is listed here so a change to it still
      // invalidates a cached run rather than silently replaying one.
      "env": ["PROFILE_APEX"]
    },
    // The root configs live outside every package, so the default inputs miss
    // them and a tightened rule would replay an old pass. Listed here rather
    // than in globalDependencies, which would also move the build hash and
    // redeploy every container on a lint-rule edit.
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxfmtrc.json"]
    },
    "format": {
      // Rewrites files in place, so a cache hit would skip real work.
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
