{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // PROFILE_APEX is read at build time, not only at run time: the profile
      // app prerenders its pages, so the school switcher's absolute links are
      // baked in. Without it in the hash a staging build replays the cached
      // production artifact and ships a switcher pointing at the live site.
      "env": ["PROFILE_APEX"],
      "outputs": [
        "dist/**",
        "build/**",
        ".strapi/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      // base.json sets incremental, so tsc --noEmit still writes this.
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      // The profile suite pins this in its vitest config so an ambient value
      // cannot change the result; it is listed here so a change to it still
      // invalidates a cached run rather than silently replaying one.
      "env": ["PROFILE_APEX"]
    },
    "lint": {},
    "format:check": {},
    "format": {
      // Rewrites files in place, so a cache hit would skip real work.
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
