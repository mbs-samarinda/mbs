{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "packages/ui/src/styles/globals.css",
    "functions": [
      "cn",
      "cva"
    ]
  },
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "apps/cms/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.github/**"
  ]
}
