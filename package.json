{
  "name": "mbs",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:generate": "pnpm --filter @mbs/db generate",
    "db:migrate": "pnpm --filter @mbs/db migrate",
    "gate": "pnpm format:check && pnpm lint && turbo run typecheck test build"
  },
  "devDependencies": {
    "lefthook": "^2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn": "^4.21.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "intent": {
    "skills": [
      "@tanstack/router-core#router-core",
      "@tanstack/router-core#router-core/auth-and-guards",
      "@tanstack/router-core#router-core/code-splitting",
      "@tanstack/router-core#router-core/data-loading",
      "@tanstack/router-core#router-core/navigation",
      "@tanstack/router-core#router-core/not-found-and-errors",
      "@tanstack/router-core#router-core/path-params",
      "@tanstack/router-core#router-core/search-params",
      "@tanstack/router-core#router-core/type-safety",
      "@tanstack/router-plugin#router-plugin",
      "@tanstack/react-table#getting-started",
      "@tanstack/react-table#create-table-hook",
      "@tanstack/react-table#table-state",
      "@tanstack/react-table#with-tanstack-query",
      "@tanstack/table-core#core",
      "@tanstack/table-core#client-vs-server",
      "@tanstack/table-core#pagination",
      "@tanstack/table-core#sorting",
      "@tanstack/table-core#column-filtering",
      "@tanstack/table-core#typescript"
    ]
  }
}
