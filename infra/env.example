# The template for /opt/mbs/.env on the VPS.
#
# This file is the only place the production secrets exist. It is never in Git,
# never in an image, and nothing in CI knows its contents — the deploy workflow
# copies compose.prod.yml and the scripts, and leaves this alone.
#
#   sudo install -m 600 -o root -g root env.example /opt/mbs/.env
#   sudo /opt/mbs/generate-secrets.sh >> /opt/mbs/.env   # fills the generated half
#   sudo -e /opt/mbs/.env                                # fill in the rest by hand
#
# The image pins live in /opt/mbs/images.env instead, which deploy.sh rewrites
# on every deploy. Do not put them here.

# ── Generated once, by generate-secrets.sh ───────────────────────────────────
# Every one of these must be STABLE FOREVER. Rotating any Strapi value
# invalidates every admin session and API token; rotating a database password
# without an ALTER ROLE locks the application out of its own data.
POSTGRES_PASSWORD=
CMS_DB_PASSWORD=
REVALIDATE_SECRET=
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# ── The domain this box serves ───────────────────────────────────────────────
# PROFILE_APEX is read when the profile process starts, so the apex cutover is a
# change here plus a restart, not a rebuild. CMS_HOST is separate because Strapi
# stays on cms.mbss.sch.id through that cutover.
PROFILE_APEX=new.mbss.sch.id
CMS_HOST=cms.mbss.sch.id
# Where the profile's server reads Strapi. Public rather than the internal
# service name, because the same value is handed to browsers for media when the
# filesystem provider is in use. Untested from inside a container; see the open
# item in DEPLOYMENT-PLAN.md.
CMS_URL=https://cms.mbss.sch.id
# Let's Encrypt registration. A real mailbox: expiry warnings go here.
CADDY_EMAIL=

# ── Object storage (Biznet Gio) ──────────────────────────────────────────────
# Media only. Do not point any of this at mbss-ppdb, which holds real applicant
# PII, or at mbss-backups.
AWS_BUCKET=mbss-uploads
AWS_ENDPOINT=https://nos.jkt-1.neo.id
AWS_REGION=idn
AWS_BASE_URL=https://nos.jkt-1.neo.id/mbss-uploads
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
# Recorded, not used at runtime: the profile bakes it into
# images.remotePatterns at build time. It must match what release.yml built
# with, and changing it needs a rebuild rather than a restart.
MEDIA_BASE_URL=https://nos.jkt-1.neo.id/mbss-uploads

# ── Backups ──────────────────────────────────────────────────────────────────
# The PUBLIC half of the age key, and only the public half. Generate the pair on
# your own machine and keep the private half in a password manager. The previous
# iteration's backups are unreadable because its key lived on this box.
BACKUP_AGE_RECIPIENT=
BACKUP_BUCKET=mbss-backups
BACKUP_KEEP_DAYS=30

# ── API: required to boot, not yet used ──────────────────────────────────────
# The API refuses to start without these even though only the public
# getCurrentCycle route is reached today. Staff sign-in belongs to the committee
# app, which is still a scaffold and has no host here, so Google has nowhere to
# call back to. Placeholder-shaped values until it ships.
BETTER_AUTH_URL=https://admin.mbss.sch.id
ADMIN_APP_URL=https://admin.mbss.sch.id
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
# Optional. When set, that address is ensured as an administrator with access to
# every school on each API boot. Nothing can grant staff access before one
# administrator exists.
BOOTSTRAP_ADMIN_EMAIL=
